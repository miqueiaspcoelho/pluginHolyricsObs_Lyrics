{
  "name": "pluginholyricsobslyrics",
  "version": "1.0.0",
  "main": "main.js",
  "description": "Plugin para Holyrics e Obs - Trasmissão de Letras",
  "author": "Miquéias Coelho",
  "scripts": {
    "electron": "electron .",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.miqueiaspcoelho.pluginholyricsobslyrics",
    "productName": "PluginHoLyricsOBS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/music_note_icon-icons.com_498704.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "HolyricsObsPlugin"
    }
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^24.6.0"
  }
}
