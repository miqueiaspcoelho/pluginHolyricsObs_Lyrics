{
  "name": "pluginholyricsobslyrics",
  "version": "1.0.0",
  "description": "Plugin para exibir letras do Holyrics no OBS via WebSocket.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "holyrics",
    "obs",
    "lyrics"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "node-fetch": "^2.7.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.seuprojeto.holyricsobs",
    "productName": "Holyrics OBS Plugin",
    "files": [
      "**/*",
      "!node_modules/concurrently/**/*"
    ],
    "extraFiles": [
      "main.js",
      "index.html",
      "renderer.js",
      "preload.js",
      "server_ws.js",
      "mini_http_server.js",
      "server_functions.js",
      "client_ws.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "mac": {
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Holyrics OBS Plugin"
    }
  }
}
